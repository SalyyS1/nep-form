# Local preview needs no cloud credentials.
# Optional database location for the local API; default work/local-data/store.sqlite
NEP_DB_PATH=

# Hosted mode: PostgreSQL only. Enter real secrets into .env or hosting settings, never VITE_*.
# npm run dev stays local; npm start loads .env for the hosted runtime.
NODE_ENV=production
APP_ORIGIN=https://your-service.onrender.com
DATABASE_URL=
# Supabase: Connect -> Session pooler (IPv4), port5432. Percent-encode password.
# Optional CA certificate file if your provider requires its root CA for verified TLS.
PG_CA_FILE=
# Only initial setup; remove these after first admin creation. Never resets existing admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Chủ cửa hàng
SHOP_CONTACT_EMAIL=

# Transactional mail: verify sending domain in Resend, enter key privately.
# Keep disabled until the provider has accepted the sender; never expose these through VITE_*.
MAIL_ENABLED=false
MAIL_FROM="NẾP FORM <hello@salyyy.tech>"
RESEND_API_KEY=
# Stable random secret, at least32 characters; keep unchanged when rotating provider API keys.
MAIL_QUEUE_KEY=
# Enable only behind the VPS Nginx that overwrites X-Real-IP; bind HOST=127.0.0.1.
TRUST_PROXY_LOOPBACK=false

{
  "name": "nep-form-local-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "stop": "node scripts/stop-local.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test --test-concurrency=1 tests/server/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/server/*.test.mjs",
    "test:e2e": "python tests/browser/store-local.spec.py",
    "test:studio": "python tests/browser/custom-studio.spec.py",
    "test:motion": "python tests/browser/home-motion.spec.py",
    "test:assistance": "python tests/browser/studio-assistance.spec.py",
    "test:fonts": "python tests/browser/font-library.spec.py",
    "test:library": "python tests/browser/studio-library.spec.py",
    "test:text-effects": "python tests/browser/text-effects.spec.py",
    "generate:builtin-fonts": "node scripts/generate-builtin-font-data.mjs",
    "generate:custom-fonts": "node scripts/generate-custom-fonts.mjs",
    "test:support": "python tests/browser/admin-support.spec.py",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "db:init": "node --env-file-if-exists=.env scripts/database-cli.mjs init",
    "db:check": "node --env-file-if-exists=.env scripts/database-cli.mjs check",
    "db:backup": "node --env-file-if-exists=.env scripts/database-cli.mjs backup",
    "db:restore": "node --env-file-if-exists=.env scripts/database-cli.mjs restore",
    "test:postgres": "node --test --test-concurrency=1 tests/server/postgres-hosting.test.mjs",
    "test:hosted": "python tests/browser/hosted-postgres.spec.py"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "gsap": "^3.15.0",
    "lucide-react": "1.59.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
